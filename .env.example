# ==========================================
# NeuraSync AI — Environment Variables
# ==========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
# ==========================================

# Supabase (Required — Frontend)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact Form Webhook (Required — Frontend)
VITE_CONTACT_WEBHOOK_URL=

# Cloudflare Turnstile (Optional — Frontend)
VITE_TURNSTILE_SITE_KEY=

# n8n Webhook (Required — Serverless API only, NOT exposed to browser)
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
